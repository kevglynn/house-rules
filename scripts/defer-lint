#!/usr/bin/env python3
"""defer-lint — mechanical check for the defer-convention rule.

Scans a source tree for `defer:` comments and flags entries that violate
the no-trigger law: every defer MUST carry an "upgrade when:" clause.
Missing "ceiling:" is reported as a warning (lesser severity, does not
fail the scan). Converts the rule's most checkable MUST from advisory
prose into an observable exit code.

The grammar (marker word, clause requirements, comment prefixes, scanned
file set) is read from profiles/conventions.toml — the single source of
truth the rule fragment is rendered from. Resolution: --profile flag >
CONVENTIONS_PROFILE env > nearest profiles/conventions.toml walking up
from the scan root (the repo being checked). A tree with no discoverable
profile falls back to the built-in copy of the same grammar so the
checker keeps working standalone (advisory posture); a DISCOVERED profile
without a [defer] section also falls back (it predates the section). But
explicit selection is loud: a --profile/env profile missing [defer], or
any profile that is unreadable or invalid, is an error — never a silent
fallback. The JSON payload and human summary echo grammar_source.

Multi-line aware: ceiling/upgrade-when clauses often continue on the
following comment line(s); continuation lines are scanned before a clause
is declared missing.

Exit codes: 0 clean (warnings allowed) · 1 violations · 2 usage error ·
3 I/O or profile error. Human-readable output by default; --json for
agents. I/O and usage errors are JSON on stderr in both output modes.
Non-interactive.
"""

import argparse
import json
import os
import re
import sys
import tomllib
from pathlib import Path

PROFILE_RELPATH = Path("profiles") / "conventions.toml"

# The marker word, assembled from parts so no copy of this file — the
# running one or a distributed one inside a scanned tree — ever contains a
# comment-marker-adjacent occurrence the scan would match. Content-side
# exclusion; no path special-casing needed (the tests and the profile use
# the same trick).
_D = "defer" + ":"

# Compatibility fallback: the same grammar the profile's [defer] section
# carries, used only when no profile is discoverable (or the discovered
# profile has no [defer] section). Parity with the kit profile is pinned
# by the test suite — edit the profile, not this dict.
FALLBACK_DEFER = {
    "marker_word": _D[:-1],
    "marker_suffix": _D[-1],
    "clauses": {
        "upgrade-when": {"pattern": r"upgrade\s+when:",
                         "flags": ["IGNORECASE"], "severity": "error"},
        "ceiling": {"pattern": "ceiling:",
                    "flags": ["IGNORECASE"], "severity": "warning"},
    },
    "scan": {
        # Comment marker immediately (modulo whitespace) before the word —
        # the marker requirement keeps prose that merely mentions the
        # convention out. Continuations accept any single-line marker.
        "marker_line_prefixes": ["#+", "//+", r"/\*+", "--+", r"\*+"],
        "continuation_prefixes": ["#+", "//+", "--+", r"\*+"],
        # defer: no --exclude flag; the skip list below is the only noise
        # filter. ceiling: a generated dir named outside this list gets
        # scanned. upgrade when: a real target repo surfaces a generated
        # dir the list misses.
        "skip_dirs": [
            ".git", "node_modules", "__pycache__", ".venv", "venv", ".tox",
            "dist", "build", "target", "vendor", ".beads", ".dolt", ".next",
            ".cache", ".mypy_cache", ".pytest_cache",
        ],
        # Well-known extensionless source files scanned by name.
        "extra_filenames": ["Makefile", "Dockerfile"],
        # Source files only: docs/markdown quote defer examples as prose
        # and are deliberately not scanned. Extensionless files are scanned
        # when they start with a shebang.
        "source_exts": [
            ".py", ".pyi", ".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx",
            ".rs", ".go", ".java", ".kt", ".kts", ".scala", ".c", ".h",
            ".cc", ".cpp", ".hpp", ".cs", ".m", ".mm", ".swift", ".rb",
            ".php", ".pl", ".pm", ".lua", ".sql", ".sh", ".bash", ".zsh",
            ".ps1", ".r", ".jl", ".ex", ".exs", ".erl", ".hs", ".elm",
            ".clj", ".cljs", ".dart", ".groovy", ".tf", ".hcl", ".yaml",
            ".yml", ".toml", ".ini", ".cfg", ".css", ".scss", ".less",
            ".vue", ".svelte", ".mk",
        ],
    },
}

# Assembled with _D so the bad examples never register as real defers in
# any copy of this file that lands inside a scanned tree.
EPILOG = f"""\
the convention ({_D[:-1]}-convention rule):
  {_D} <what was simplified>. ceiling: <known limitation>. upgrade when: <trigger condition>.

  Any comment prefix (#, //, /* */, --); clauses may continue on the
  following comment line(s).

good — names ceiling and trigger (two-line form):
  # {_D} global lock on config reload. ceiling: blocks all requests during reload (~50ms).
  # upgrade when: reload frequency exceeds 1/minute or p99 latency matters.

  // {_D} O(n^2) duplicate check. ceiling: scans full list on every insert.
  // upgrade when: list exceeds ~1000 items (profile first).

  # {_D} naive retry with fixed delay. ceiling: no backoff, no jitter, max 3 retries.
  # upgrade when: upstream starts throttling or retry storms appear in logs.

bad — no trigger (violation, exit 1):
  # {_D} simplified validation.
  # {_D} in-memory cache. ceiling: lost on restart.

  A deferral without a trigger is just a TODO with a fancier name.

marker comparison:
  {_D}  deliberate simplification; ceiling + trigger required; low rot risk
  TODO    unstructured reminder; no ceiling, no trigger; "later" = never
  FIXME   actually broken; urgency implied but not quantified

grammar source:
  profiles/conventions.toml [{_D[:-1]}] section when present (--profile /
  CONVENTIONS_PROFILE / upward walk from --root); built-in fallback with
  the same grammar otherwise.

known limitations:
  - continuation folding accepts any comment marker, so an unrelated
    comment line directly beneath a defer can rescue it (false negative)
  - a string literal with a comment marker directly before the word is
    flagged (false positive) — assemble such strings from parts, as this
    checker's own source, tests, and profile do
"""


def emit_error(message, kind, code):
    json.dump({"ok": False, "error": message, "error_kind": kind,
               "exit_code": code}, sys.stderr, sort_keys=True)
    sys.stderr.write("\n")
    sys.exit(code)


def nonempty(value):
    if not value.strip():
        raise argparse.ArgumentTypeError("must be a non-empty string")
    return value


class JsonArgumentParser(argparse.ArgumentParser):
    """argparse that reports usage errors as JSON on stderr (agent convention)."""

    def error(self, message):
        json.dump({"ok": False, "error": message, "exit_code": 2},
                  sys.stderr, sort_keys=True)
        sys.stderr.write("\n")
        sys.exit(2)


# --------------------------------------------------------------------------
# Profile plumbing — discover_profile, resolve_profile_path, load_profile,
# compile_entry, and FLAG_NAMES are verbatim copies from scripts/conventions
# (the canonical copy; Planner decision on the tlp epic — do not fork the
# behavior).
# --------------------------------------------------------------------------

# Pattern-entry flags name Python `re` module constants (design-doc schema:
# token entries are {pattern, flags} tables; the same shape serves every
# detector in the profile).
FLAG_NAMES = {
    "IGNORECASE": re.IGNORECASE,
    "MULTILINE": re.MULTILINE,
    "DOTALL": re.DOTALL,
    "VERBOSE": re.VERBOSE,
    "ASCII": re.ASCII,
}


def discover_profile(start_dir):
    """Nearest profiles/conventions.toml walking up from start_dir, stopping
    at the repo boundary (.git) so an ancestor repo's profile is never
    picked up. Returns None when absent — the caller decides whether
    absence is an error (this CLI) or a fallback (standalone checkers)."""
    for candidate_dir in [start_dir, *start_dir.parents]:
        candidate = candidate_dir / PROFILE_RELPATH
        if candidate.is_file():
            return candidate
        if (candidate_dir / ".git").exists():
            break
    return None


def resolve_profile_path(flag_value):
    if flag_value:
        return Path(flag_value)
    env_value = os.environ.get("CONVENTIONS_PROFILE")
    if env_value:
        return Path(env_value)
    cwd = Path.cwd().resolve()
    found = discover_profile(cwd)
    if found:
        return found
    emit_error(
        f"no {PROFILE_RELPATH} found walking up from {cwd}; "
        "pass --profile or set CONVENTIONS_PROFILE", "io", 3)


def load_profile(flag_value):
    path = resolve_profile_path(flag_value)
    try:
        with open(path, "rb") as f:
            return tomllib.load(f), path.resolve()
    except (OSError, tomllib.TOMLDecodeError) as exc:
        emit_error(f"cannot load profile {path}: {exc}", "io", 3)


def compile_entry(entry, where):
    """Compile a pattern entry: a bare regex string or a {pattern, flags} table."""
    if isinstance(entry, str):
        pattern, flag_names = entry, []
    elif isinstance(entry, dict) and "pattern" in entry:
        pattern, flag_names = entry["pattern"], entry.get("flags", [])
    else:
        emit_error(f"{where}: expected a pattern string or "
                   "a {pattern, flags} table", "profile", 3)
    flags = 0
    for name in flag_names:
        if name not in FLAG_NAMES:
            emit_error(f"{where}: unknown flag {name!r} "
                       f"(known: {sorted(FLAG_NAMES)})", "profile", 3)
        flags |= FLAG_NAMES[name]
    try:
        return re.compile(pattern, flags)
    except re.error as exc:
        emit_error(f"{where}: invalid pattern {pattern!r}: {exc}",
                   "profile", 3)


def build_grammar(spec, origin):
    """Compile a [defer] grammar spec into matchers. `origin` names the
    grammar source (profile path or the built-in fallback) for errors."""
    try:
        marker = spec["marker_word"] + spec["marker_suffix"]
        scan = spec["scan"]
        marker_prefixes = scan["marker_line_prefixes"]
        cont_prefixes = scan["continuation_prefixes"]
        skip_dirs = set(scan["skip_dirs"])
        extra_filenames = set(scan["extra_filenames"])
        source_exts = set(scan["source_exts"])
        clause_specs = spec["clauses"]
    except (KeyError, TypeError) as exc:
        emit_error(f"{origin}: [defer] grammar is missing required key: "
                   f"{exc}", "profile", 3)
    if not isinstance(clause_specs, dict):
        emit_error(f"{origin}: [defer.clauses] must be a table of named "
                   "clause tables, not an array", "profile", 3)
    clauses = []
    for name, entry in clause_specs.items():
        severity = entry.get("severity") if isinstance(entry, dict) else None
        if severity not in ("error", "warning"):
            emit_error(f"{origin}: defer.clauses.{name} severity must be "
                       "'error' or 'warning'", "profile", 3)
        clauses.append((name,
                        compile_entry(entry, f"{origin}: defer.clauses.{name}"),
                        severity))
    try:
        defer_re = re.compile(
            r"(?P<marker>" + "|".join(marker_prefixes) + r")[ \t]*"
            + re.escape(marker) + r"[ \t]*(?P<rest>.*)")
        cont_re = re.compile(
            r"^[ \t]*(?:" + "|".join(cont_prefixes) + r")[ \t]?(?P<rest>.*)")
    except (re.error, TypeError) as exc:
        emit_error(f"{origin}: invalid comment-prefix list: {exc}",
                   "profile", 3)
    return {
        "marker": marker,
        "defer_re": defer_re,
        "cont_re": cont_re,
        "clauses": clauses,
        "severity_of": {name: sev for name, _, sev in clauses},
        "skip_dirs": skip_dirs,
        "extra_filenames": extra_filenames,
        "source_exts": source_exts,
    }


def resolve_grammar(flag_value, root):
    """Grammar per the resolution chain: explicit profile (flag/env) >
    discovered profile at/above the scan root > built-in fallback. Returns
    (grammar, source_label). Absence of any profile falls back, and so
    does a DISCOVERED profile without a [defer] section (it predates the
    section); but an EXPLICITLY selected profile missing the section is a
    profile error — the caller named a grammar source that has no grammar.
    A named-or-found profile that fails to load is always an error."""
    explicit = bool(flag_value or os.environ.get("CONVENTIONS_PROFILE"))
    discovered = None if explicit else discover_profile(root)
    if explicit or discovered:
        profile, profile_path = load_profile(
            flag_value if explicit else str(discovered))
        section = profile.get(_D[:-1])
        if section is not None:
            return (build_grammar(section, str(profile_path)),
                    str(profile_path))
        if explicit:
            emit_error(
                f"{profile_path}: profile has no [{_D[:-1]}] section "
                "(explicitly selected profiles must carry the grammar)",
                "profile", 3)
    return (build_grammar(FALLBACK_DEFER, "built-in fallback grammar"),
            "built-in fallback")


def iter_source_files(root, grammar):
    # No self-exclusion: every copy of this checker — and of the profile
    # data file — is content-clean by construction (parts assembly above),
    # so a distributed copy inside the scanned tree is just another clean
    # source file.
    skip_dirs = grammar["skip_dirs"]
    source_exts = grammar["source_exts"]
    extra_filenames = grammar["extra_filenames"]
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in skip_dirs)
        for name in sorted(filenames):
            child = Path(dirpath) / name
            if child.is_symlink() or not child.is_file():
                continue
            rel = child.relative_to(root)
            if child.suffix.lower() in source_exts or name in extra_filenames:
                yield child, rel
            elif not child.suffix:
                try:
                    with open(child, "rb") as f:
                        if f.read(2) == b"#!":
                            yield child, rel
                except OSError:
                    continue


def read_text(path):
    """Returns decoded text, or None for binary/unreadable files."""
    try:
        raw = path.read_bytes()
    except OSError:
        return None
    if b"\x00" in raw[:8192]:
        return None
    return raw.decode("utf-8", errors="replace")


def collect_defers(lines, grammar):
    """Yields (lineno, defer_text) with continuation comment lines folded in."""
    defer_re = grammar["defer_re"]
    cont_re = grammar["cont_re"]
    i = 0
    n = len(lines)
    while i < n:
        m = defer_re.search(lines[i])
        if not m:
            i += 1
            continue
        lineno = i + 1
        parts = [m.group("rest")]
        # Block folding keys off literal /* and */ — C-style delimiters are
        # hard-coded even though line prefixes are profile-configurable. A
        # grammar whose block comments use other delimiters gets plain
        # continuation-prefix folding instead.
        in_block = m.group("marker").startswith("/*") and "*/" not in m.group("rest")
        j = i + 1
        while j < n:
            line = lines[j]
            if defer_re.search(line):
                break  # a new defer starts; it gets its own entry
            if in_block:
                part = line.strip()
                closed = "*/" in part
                part = re.sub(r"^\*+[ \t]?", "", part).replace("*/", "")
                parts.append(part)
                j += 1
                if closed:
                    break
                continue
            c = cont_re.match(line)
            if not c:
                break
            parts.append(c.group("rest"))
            j += 1
        yield lineno, " ".join(p.strip() for p in parts).strip()
        i = j if j > i else i + 1


def scan_tree(root, grammar):
    files_scanned = 0
    files_skipped = 0
    defer_count = 0
    findings = []
    severity_of = grammar["severity_of"]
    for path, rel in iter_source_files(root, grammar):
        text = read_text(path)
        if text is None:
            files_skipped += 1
            continue
        files_scanned += 1
        for lineno, defer_text in collect_defers(text.splitlines(), grammar):
            defer_count += 1
            missing = [name for name, detector, _ in grammar["clauses"]
                       if not detector.search(defer_text)]
            if not missing:
                continue
            severity = ("error"
                        if any(severity_of[n] == "error" for n in missing)
                        else "warning")
            body = defer_text.strip()
            if body.endswith("*/"):
                body = body[:-2].rstrip()
            snippet = (grammar["marker"] + " " + body).strip()
            findings.append({
                "file": str(rel),
                "line": lineno,
                "text": snippet[:200],
                "missing": missing,
                "severity": severity,
            })
    return files_scanned, files_skipped, defer_count, findings


def main(argv=None):
    parser = JsonArgumentParser(
        prog="defer-lint",
        description=(
            "Scan for defer: comments violating the no-trigger law "
            "(missing 'upgrade when:' clause). Multi-line comment "
            "continuations are honored. Grammar comes from "
            "profiles/conventions.toml when present (--profile / "
            "CONVENTIONS_PROFILE / upward walk from --root); built-in "
            "fallback otherwise. Exit codes: 0 clean, 1 violations, "
            "2 usage error, 3 I/O or profile error."
        ),
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--root", default=".", type=nonempty,
                        help="Directory tree to scan (default: current directory)")
    parser.add_argument("--profile",
                        help="path to profile TOML (default: resolution "
                             "chain in the description)")
    parser.add_argument("--json", action="store_true",
                        help="Structured JSON output on stdout")
    args = parser.parse_args(argv)

    root = Path(args.root)
    if not root.is_dir():
        emit_error(f"root is not a directory: {root}", "io", 3)
    root = root.resolve()

    grammar, grammar_source = resolve_grammar(args.profile, root)
    files_scanned, files_skipped, defer_count, findings = scan_tree(
        root, grammar)
    errors = [f for f in findings if f["severity"] == "error"]
    warnings = [f for f in findings if f["severity"] == "warning"]
    exit_code = 1 if errors else 0

    if args.json:
        json.dump({
            "ok": not errors,
            "root": str(root),
            "grammar_source": grammar_source,
            "files_scanned": files_scanned,
            "files_skipped": files_skipped,
            "defer_comments": defer_count,
            "findings": findings,
        }, sys.stdout, sort_keys=True)
        sys.stdout.write("\n")
        return exit_code

    severity_of = grammar["severity_of"]
    for f in findings:
        if f["severity"] == "error":
            name = next(n for n in f["missing"]
                        if severity_of.get(n) == "error")
            label = f"missing {name} clause"
        else:
            label = f"missing {f['missing'][0]} clause (warning)"
        print(f"{f['file']}:{f['line']}: {label} — {f['text']}")
    status = ("clean" if not findings
              else f"{len(errors)} violation(s), {len(warnings)} warning(s)")
    skipped = (f" ({files_skipped} unreadable/binary skipped)"
               if files_skipped else "")
    print(f"Scanned {files_scanned} files{skipped}, "
          f"{defer_count} defer comment(s): {status}. "
          f"[grammar: {grammar_source}]")
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
