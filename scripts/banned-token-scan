#!/usr/bin/env python3
"""banned-token-scan — candidate reporter for agent-identity's banned tokens.

Scans text (files or stdin) for the agent-identity rule's four banned
token classes used to frame work-to-be-done and reports every candidate
hit with its class and location. Deterministic reporter only: the rule's
"not regressions" exceptions (historical facts, product/API behavior,
quoted references, agent-process units) require reading intent, so that
judgment stays with the reader and the review lenses — this tool never
suppresses a hit on their behalf.

The token catalog (class keys, per-token patterns and flags) is read from
profiles/conventions.toml — the single source of truth the rule's catalog
enumeration is rendered from. Resolution: --profile flag >
CONVENTIONS_PROFILE env > nearest profiles/conventions.toml walking up
from the current directory. A tree with no discoverable profile falls
back to the built-in copy of the same catalog so the checker keeps
working standalone (advisory posture); a DISCOVERED profile without a
[tokens] section also falls back (it predates the section). But explicit
selection is loud: a --profile/env profile missing [tokens], or any
profile that is unreadable or invalid, is an error — never a silent
fallback. The JSON payload and human summary echo grammar_source.

Content self-matching, two idioms:
  - This source file: every token literal — including one class name —
    is assembled from parts, so no copy of this scanner (the kit one or
    a distributed one) ever flags its own source. Content-side exclusion;
    no path special-casing (same idiom as scripts/defer-lint).
  - Data files (the profile and every distributed copy of it): a catalog
    cannot assemble its own tokens from parts, so the scanner honors a
    declared-token region contract — lines between the marker pair (the
    catalog's exclude_marker with ":begin" / ":end" appended) are
    catalog DATA, and matching is suppressed there, whatever the file's
    path or name.

Exit codes: 0 clean · 1 candidate hits · 2 usage error · 3 I/O or profile
error. Human-readable output by default; --json for agents. I/O and usage
errors are JSON on stderr in both output modes. Non-interactive.
"""

import argparse
import json
import os
import re
import sys
import tomllib
from pathlib import Path

PROFILE_RELPATH = Path("profiles") / "conventions.toml"

_J = "".join

# --- Token literals, assembled from parts (see module docstring) --------
_hours = _J(("hou", "rs"))
_days = _J(("da", "ys"))
_weeks = _J(("wee", "ks"))
_months = _J(("mon", "ths"))
_quarters = _J(("quar", "ters"))
_sprints = _J(("spri", "nts"))
_story_points = _J(("story poi", "nts"))
_man_hours = "man-" + _hours
_person_hours = "person-" + _hours
_engineer_hours = "engineer-" + _hours
_dev_hours = "dev-" + _hours

_one_developer = _J(("one dev", "eloper"))
_a_developer = _J(("a dev", "eloper"))
_engineers = _J(("engin", "eers"))
_small_team = _J(("small te", "am"))
_team_of = _J(("team o", "f"))
_with_more_people = _J(("with more peo", "ple"))
_engineering_team = _J(("engineering te", "am"))

_timeline = _J(("time", "line"))
_schedule = _J(("sched", "ule"))
_ambitious = _J(("ambi", "tious"))
_aggressive = _J(("aggres", "sive"))
_on_track = _J(("on tra", "ck"))
_eta = _J(("ET", "A"))
_by_eod = _J(("by EO", "D"))
_by_end_of_week = _J(("by end of wee", "k"))
_takes_a_while = _J(("takes a whi", "le"))
_takes_long = _J(("takes lo", "ng"))
_quick_win = _J(("quick w", "in"))

_estimate = _J(("esti", "mate"))
_i_estimate = "I " + _estimate
_id_estimate = "I'd " + _estimate
_rough_estimate = "rough " + _estimate
_ballpark = _J(("ball", "park"))
_roughly = _J(("roug", "hly"))

# Class keys as reported in findings. One embeds a token, so it is
# assembled too.
CLS_TIME = "time-units"
CLS_TEAM = "team-size"
CLS_SCHED = _schedule + "-framing"
CLS_EST = "estimation-verbs"

# Digits or spelled-out small numbers, for "team of N" / "N <unit>" shapes.
NUM = r"(?:\d+|one|two|three|four|five|six|seven|eight|nine|ten)"


def _word_pat(token):
    """Whole-word/phrase pattern string for a token; spaces match any
    whitespace run. No escaping: the profile carries these same pattern
    strings unescaped, so escaping here would break the byte-parity pin.
    The no-metacharacters premise is itself pinned by
    test_fallback_displays_carry_no_regex_metacharacters."""
    return r"\b" + token.replace(" ", r"\s+") + r"\b"


def _entry(display, pattern=None, flags=("IGNORECASE",)):
    return {"display": display,
            "pattern": pattern or _word_pat(display),
            "flags": list(flags)}


# Compatibility fallback: the same catalog the profile's [tokens] section
# carries, restricted to the keys this checker consumes (per-class
# report_as + {display, pattern, flags} entries, and the scan exclude
# marker; render-only keys like rule_label / rule_items are deliberately
# absent). Used only when no profile is discoverable (or the discovered
# profile has no [tokens] section). Parity with the kit profile is pinned
# by the test suite — edit the profile, not this dict.
#
# Entry order within a class is matcher order: longest display first, so
# overlap dedupe keeps the most specific token (person-<unit> wins over
# the bare unit). The base exclude marker below is inert on its own — only
# the ":begin"-suffixed form (joined at runtime, never at rest in this
# file) opens a declared-token region.
FALLBACK_TOKENS = {
    "exclude_marker": "banned-token-scan:declared-tokens",
    "classes": {
        "time_units": {
            "report_as": CLS_TIME,
            "entries": [
                _entry(_engineer_hours),
                _entry(_person_hours),
                _entry(_story_points),
                _entry(_man_hours),
                _entry(_dev_hours),
                _entry(_quarters),
                _entry(_sprints),
                _entry(_months),
                _entry(_hours),
                _entry(_weeks),
                _entry(_days),
            ],
        },
        "team_size": {
            "report_as": CLS_TEAM,
            "entries": [
                _entry(_with_more_people),
                _entry(_engineering_team),
                _entry(_one_developer),
                _entry(_a_developer),
                _entry(_small_team),
                _entry(_team_of + " N",
                       r"\b" + _team_of.replace(" ", r"\s+") + r"\s+"
                       + NUM + r"\b"),
                _entry("N " + _engineers,
                       r"\b" + NUM + r"(?:\s*[-–]\s*" + NUM + r")?\s+"
                       + _engineers + r"\b"),
            ],
        },
        _schedule: {
            "report_as": CLS_SCHED,
            "entries": [
                _entry(_by_end_of_week),
                _entry(_takes_a_while),
                _entry(_aggressive),
                _entry(_takes_long),
                _entry(_ambitious),
                _entry(_quick_win),
                _entry(_timeline),
                _entry(_schedule),
                _entry(_on_track),
                _entry(_by_eod),
                # Flag-free: lowercase "eta" is a Greek letter / word
                # fragment; only the uppercase acronym is banned.
                _entry(_eta, flags=()),
            ],
        },
        "estimation_verbs": {
            "report_as": CLS_EST,
            "entries": [
                _entry(_roughly + " N <unit>",
                       r"\b" + _roughly + r"\s+" + NUM + r"\s+(?:" + _hours
                       + "|" + _days + "|" + _weeks + r")\b"),
                _entry(_rough_estimate),
                _entry(_id_estimate,
                       r"\bI['’]d\s+" + _estimate + r"\b"),
                _entry(_i_estimate),
                _entry(_ballpark),
            ],
        },
    },
}

EPILOG = f"""\
token classes (agent-identity rule, banned when framing work-to-be-done):
  {CLS_TIME}: {_hours}, {_days}, {_weeks}, {_months}, {_quarters},
    {_sprints}, {_man_hours}, {_person_hours}, {_engineer_hours},
    {_dev_hours}, {_story_points}
  {CLS_TEAM}: {_one_developer}, {_a_developer}, N {_engineers},
    {_small_team}, {_team_of} N, {_with_more_people}, {_engineering_team}
  {CLS_SCHED}: {_timeline}, {_schedule}, {_ambitious}, {_aggressive},
    {_on_track}, {_eta}, {_by_eod}, {_by_end_of_week}, {_takes_a_while},
    {_takes_long}, {_quick_win}
  {CLS_EST}: {_i_estimate}, {_id_estimate}, {_rough_estimate},
    {_ballpark}, {_roughly} N <unit>

examples:
  banned-token-scan transcript.md draft.md          # scan files
  banned-token-scan --json < response.txt           # scan stdin, JSON out
  echo "this will take 6 {_weeks}" | banned-token-scan   # exit 1

judgment boundary — reporter, not judge:
  the rule's "not regressions" exceptions (historical facts like "the bug
  was open for 3 {_weeks}", product/API behavior like "a 30-second
  timeout", quoted references, agent-process units) are deliberately NOT
  detected — telling them apart requires reading intent. Every hit is a
  candidate for the reader or the review lenses to triage.

catalog source:
  profiles/conventions.toml [tokens] section when present (--profile /
  CONVENTIONS_PROFILE / upward walk from the current directory); built-in
  fallback with the same catalog otherwise.

declared-token data (content-side exclusion contract):
  a catalog data file is itself token-laden, so its catalog region is
  bracketed by marker lines — the catalog's exclude_marker
  ("{FALLBACK_TOKENS['exclude_marker']}") with ":begin" / ":end"
  appended — and matching is suppressed between them. Markers count only
  as whole tokens (a marker embedded in a longer word is inert); a
  begin+end pair on one line is a complete one-line region. This keeps
  the profile that carries the catalog, and every distributed copy of
  it, clean at any path, while real prose keeps flagging. JSON output
  reports excluded_regions / unterminated_regions counts so suppression
  is never silent.

known limitations:
  - whole-word matching only: inflected forms ("{_schedule}d",
    "{_schedule}s") are not flagged
  - matching is case-insensitive except {_eta} (uppercase acronym only)
  - matching is per-line: a phrase wrapped across a line break escapes
  - singular units ("day", "week") are not in the catalog — the rule
    bans the plural forms
  - a begin marker with no end marker suppresses matching to the end of
    that source; the contract is content-side, so a marker pasted into
    prose excludes that prose (accident hazard, not adversary defense —
    the unterminated_regions count in JSON output surfaces the accident)
  - profile discovery anchors at the invoking directory, not at each
    scanned file's location: scanning another repo's files applies THIS
    repo's catalog (pass --profile to pin the intended one)
"""


def emit_error(message, kind, code):
    json.dump({"ok": False, "error": message, "error_kind": kind,
               "exit_code": code}, sys.stderr, sort_keys=True)
    sys.stderr.write("\n")
    sys.exit(code)


class JsonArgumentParser(argparse.ArgumentParser):
    """argparse that reports usage errors as JSON on stderr (agent convention)."""

    def error(self, message):
        json.dump({"ok": False, "error": message, "exit_code": 2},
                  sys.stderr, sort_keys=True)
        sys.stderr.write("\n")
        sys.exit(2)


# --------------------------------------------------------------------------
# Profile plumbing — discover_profile, resolve_profile_path, load_profile,
# compile_entry, resolve_section, and FLAG_NAMES are verbatim copies from
# scripts/conventions (the canonical copy; Planner decision on the tlp
# epic — do not fork the behavior). The block's closed-over dependencies
# — emit_error and PROFILE_RELPATH — are part of the verbatim contract
# and pinned equal across copies by ResolveSectionPromotionTest.
# --------------------------------------------------------------------------

# Pattern-entry flags name Python `re` module constants (design-doc schema:
# token entries are {pattern, flags} tables; the same shape serves every
# detector in the profile).
FLAG_NAMES = {
    "IGNORECASE": re.IGNORECASE,
    "MULTILINE": re.MULTILINE,
    "DOTALL": re.DOTALL,
    "VERBOSE": re.VERBOSE,
    "ASCII": re.ASCII,
}


def discover_profile(start_dir):
    """Nearest profiles/conventions.toml walking up from start_dir, stopping
    at the repo boundary (.git) so an ancestor repo's profile is never
    picked up. Returns None when absent — the caller decides whether
    absence is an error (this CLI) or a fallback (standalone checkers)."""
    for candidate_dir in [start_dir, *start_dir.parents]:
        candidate = candidate_dir / PROFILE_RELPATH
        if candidate.is_file():
            return candidate
        if (candidate_dir / ".git").exists():
            break
    return None


def resolve_profile_path(flag_value):
    if flag_value:
        return Path(flag_value)
    env_value = os.environ.get("CONVENTIONS_PROFILE")
    if env_value:
        return Path(env_value)
    cwd = Path.cwd().resolve()
    found = discover_profile(cwd)
    if found:
        return found
    emit_error(
        f"no {PROFILE_RELPATH} found walking up from {cwd}; "
        "pass --profile or set CONVENTIONS_PROFILE", "io", 3)


def load_profile(flag_value):
    path = resolve_profile_path(flag_value)
    try:
        with open(path, "rb") as f:
            return tomllib.load(f), path.resolve()
    except (OSError, tomllib.TOMLDecodeError) as exc:
        emit_error(f"cannot load profile {path}: {exc}", "io", 3)


def compile_entry(entry, where):
    """Compile a pattern entry: a bare regex string or a {pattern, flags} table."""
    if isinstance(entry, str):
        pattern, flag_names = entry, []
    elif isinstance(entry, dict) and "pattern" in entry:
        pattern, flag_names = entry["pattern"], entry.get("flags", [])
    else:
        emit_error(f"{where}: expected a pattern string or "
                   "a {pattern, flags} table", "profile", 3)
    flags = 0
    for name in flag_names:
        if name not in FLAG_NAMES:
            emit_error(f"{where}: unknown flag {name!r} "
                       f"(known: {sorted(FLAG_NAMES)})", "profile", 3)
        flags |= FLAG_NAMES[name]
    try:
        return re.compile(pattern, flags)
    # TypeError: non-string pattern / non-list flags — a profile-shape
    # error, not a missing key; without this it would surface under the
    # caller's missing-required-key message.
    except (re.error, TypeError) as exc:
        emit_error(f"{where}: invalid pattern {pattern!r}: {exc}",
                   "profile", 3)


def resolve_section(flag_value, section_name, builder, fallback, noun,
                    root=None):
    """Resolve a profile section per the standalone-checker posture:
    explicit profile (flag/env) > discovered profile at/above `root`
    (default: the current directory) > built-in fallback. Returns
    (built_section, source_label). Absence of any profile falls back, and
    so does a DISCOVERED profile without the section (it predates the
    section); but an EXPLICITLY selected profile missing the section is a
    profile error — the caller named a source that carries no such
    section. A named-or-found profile that fails to load is always an
    error."""
    explicit = bool(flag_value or os.environ.get("CONVENTIONS_PROFILE"))
    if root is None:
        root = Path.cwd().resolve()
    discovered = None if explicit else discover_profile(root)
    if explicit or discovered:
        profile, profile_path = load_profile(
            flag_value if explicit else str(discovered))
        section = profile.get(section_name)
        if section is not None:
            return (builder(section, str(profile_path)), str(profile_path))
        if explicit:
            emit_error(
                f"{profile_path}: profile has no [{section_name}] section "
                f"(explicitly selected profiles must carry the {noun})",
                "profile", 3)
    return (builder(fallback, f"built-in fallback {noun}"),
            "built-in fallback")


def build_tokens(spec, origin):
    """Compile a [tokens] catalog spec into the flat matcher list plus the
    declared-token region markers. `origin` names the catalog source
    (profile path or the built-in fallback) for errors."""
    try:
        marker = spec["exclude_marker"]
        classes = spec["classes"]
    except (KeyError, TypeError) as exc:
        emit_error(f"{origin}: [tokens] catalog is missing required key: "
                   f"{exc}", "profile", 3)
    if not isinstance(marker, str) or not marker:
        emit_error(f"{origin}: tokens.exclude_marker must be a "
                   "non-empty string", "profile", 3)
    if not isinstance(classes, dict):
        emit_error(f"{origin}: [tokens.classes] must be a table of named "
                   "class tables", "profile", 3)
    matchers = []
    for group, cls_spec in classes.items():
        report_as = (cls_spec.get("report_as")
                     if isinstance(cls_spec, dict) else None)
        entries = (cls_spec.get("entries")
                   if isinstance(cls_spec, dict) else None)
        if not isinstance(report_as, str) or not isinstance(entries, list):
            emit_error(f"{origin}: tokens.classes.{group} needs report_as "
                       "and an entries list", "profile", 3)
        for i, entry in enumerate(entries):
            display = entry.get("display") if isinstance(entry, dict) else None
            if not isinstance(display, str):
                emit_error(f"{origin}: tokens.classes.{group} entry {i} "
                           "needs a display string", "profile", 3)
            matchers.append((report_as, display, compile_entry(
                entry, f"{origin}: tokens.classes.{group} entry {i}")))
    return {
        "matchers": matchers,
        "exclude_begin": marker + ":begin",
        "exclude_end": marker + ":end",
    }


def _marker_at(line, marker):
    """Index where `marker` stands as a whole token in `line` (not embedded
    in a longer word like "...:beginner"), else -1. Word-ish boundary on
    both sides so a marker-shaped substring cannot open or close a region."""
    idx = line.find(marker)
    while idx != -1:
        end = idx + len(marker)
        before_ok = idx == 0 or not (line[idx - 1].isalnum()
                                     or line[idx - 1] in "_-")
        after_ok = end >= len(line) or not (line[end].isalnum()
                                            or line[end] in "_-")
        if before_ok and after_ok:
            return idx
        idx = line.find(marker, idx + 1)
    return -1


def scan_text(name, text, catalog):
    """Returns (findings, regions_suppressed, unterminated_regions)."""
    findings = []
    regions = 0
    unterminated = 0
    excluded = False
    for lineno, line in enumerate(text.splitlines(), start=1):
        # Declared-token data region: between the begin/end marker lines
        # nothing is a candidate — the content IS the catalog. Marker
        # lines themselves are part of the region.
        if excluded:
            if _marker_at(line, catalog["exclude_end"]) != -1:
                excluded = False
            continue
        begin = _marker_at(line, catalog["exclude_begin"])
        if begin != -1:
            regions += 1
            # A begin+end pair on one line is a complete one-line region:
            # that line is suppressed, scanning resumes on the next.
            after = begin + len(catalog["exclude_begin"])
            excluded = _marker_at(line[after:], catalog["exclude_end"]) == -1
            continue
        taken = {}  # class -> list of consumed (start, end) spans
        for cls, display, pattern in catalog["matchers"]:
            for m in pattern.finditer(line):
                span = m.span()
                spans = taken.setdefault(cls, [])
                if any(span[0] < e and s < span[1] for s, e in spans):
                    continue  # overlaps a longer token already reported
                spans.append(span)
                findings.append({
                    "file": name,
                    "line": lineno,
                    "class": cls,
                    "token": display,
                    "text": line.strip()[:200],
                })
    if excluded:
        unterminated += 1
    return findings, regions, unterminated


def main(argv=None):
    parser = JsonArgumentParser(
        prog="banned-token-scan",
        description=(
            "Report candidate agent-identity banned-token hits (four "
            "classes) in text from files or stdin. Deterministic reporter: "
            "the rule's exception judgment stays with the reader. The "
            "catalog comes from profiles/conventions.toml when present "
            "(--profile / CONVENTIONS_PROFILE / upward walk from the "
            "current directory); built-in fallback otherwise. Exit codes: "
            "0 clean, 1 hits, 2 usage error, 3 I/O or profile error."
        ),
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("paths", nargs="*", metavar="FILE",
                        help="Files to scan (default: stdin)")
    parser.add_argument("--profile",
                        help="path to profile TOML (default: resolution "
                             "chain in the description)")
    parser.add_argument("--json", action="store_true",
                        help="Structured JSON output on stdout")
    args = parser.parse_args(argv)

    sources = []
    if not args.paths:
        if sys.stdin.isatty():
            emit_error("no input: pass files or pipe text on stdin",
                       "usage", 2)
        sources.append(("<stdin>", sys.stdin.read()))
    else:
        for p in args.paths:
            try:
                text = Path(p).read_text(encoding="utf-8", errors="replace")
            except OSError as e:
                emit_error(f"cannot read file: {e}", "io", 3)
            sources.append((p, text))

    catalog, grammar_source = resolve_section(
        args.profile, "tokens", build_tokens, FALLBACK_TOKENS, "catalog")

    findings = []
    regions = unterminated = 0
    for name, text in sources:
        file_findings, file_regions, file_unterm = scan_text(
            name, text, catalog)
        findings.extend(file_findings)
        regions += file_regions
        unterminated += file_unterm
    exit_code = 1 if findings else 0

    if args.json:
        json.dump({
            "ok": not findings,
            "grammar_source": grammar_source,
            "files_scanned": len(sources),
            "findings": findings,
            "excluded_regions": regions,
            "unterminated_regions": unterminated,
        }, sys.stdout, sort_keys=True)
        sys.stdout.write("\n")
        return exit_code

    for f in findings:
        print(f"{f['file']}:{f['line']}: [{f['class']}] {f['token']} — "
              f"{f['text']}")
    status = "clean" if not findings else f"{len(findings)} candidate hit(s)"
    suppressed = ""
    if regions:
        unterm = f", {unterminated} unterminated" if unterminated else ""
        suppressed = f" [declared-token regions suppressed: {regions}{unterm}]"
    print(f"Scanned {len(sources)} file(s): {status}. "
          f"[grammar: {grammar_source}]{suppressed}")
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
